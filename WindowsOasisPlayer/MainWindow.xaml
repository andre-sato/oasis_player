<Window x:Class="OasisPlayer.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Oasis Player" Width="1040" Height="700" MinWidth="820" MinHeight="560" Background="#161C19" Foreground="#E8E5E0">
  <Grid Margin="28"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" Margin="0,0,28,0"><TextBlock Text="OASIS" FontSize="28" FontWeight="Bold"/><TextBlock Text="Seu acervo, sem ruído." Foreground="#9FA6A1" Margin="0,4,0,38"/>
      <Button Content="Biblioteca" HorizontalContentAlignment="Left"/><Button Content="Playlists" HorizontalContentAlignment="Left"/><Button Content="Importar arquivos" Click="ImportFiles_Click" HorizontalContentAlignment="Left"/>
      <TextBlock Text="URL DIRETA" Foreground="#9FA6A1" FontSize="11" Margin="4,30,4,7"/><TextBox x:Name="UrlBox" Padding="9" Background="#202724" Foreground="#E8E5E0" BorderBrush="#3D4B45"/><Button Content="Baixar e adicionar" Click="Download_Click"/>
      <TextBlock x:Name="StatusText" Foreground="#9FA6A1" TextWrapping="Wrap" Margin="4,18,4,0"/>
    </StackPanel>
    <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel><TextBlock Text="Biblioteca" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="Arquivos ficam disponíveis offline neste computador." Foreground="#9FA6A1" Margin="0,4,0,20"/></StackPanel>
      <ListBox Grid.Row="1" x:Name="TracksList" Background="Transparent" BorderThickness="0" SelectionChanged="TracksList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="9" Background="#2C3833"><TextBlock Text="♫" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Artist}" Foreground="#9FA6A1" FontSize="12"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Album}" Foreground="#9FA6A1" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
      <Border Grid.Row="2" Background="#202724" CornerRadius="14" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="9" Background="#3D4B45"><TextBlock Text="♫" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="NowPlayingTitle" Text="Escolha uma música" FontWeight="SemiBold"/><TextBlock x:Name="NowPlayingArtist" Foreground="#9FA6A1" FontSize="12"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="◀" Click="Previous_Click"/><Button x:Name="PlayButton" Content="▶ Reproduzir" Click="PlayPause_Click"/><Button Content="▶|" Click="Next_Click"/></StackPanel></Grid></Border>
    </Grid>
  </Grid>
</Window>
